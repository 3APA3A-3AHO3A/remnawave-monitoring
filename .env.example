# ─────────────────────────────────────────────────────────────
#  remnawave-monitoring — настройки одной панели
#  Скопируйте в .env и заполните:  cp .env.example .env && chmod 600 .env
#  Всё время — UTC.
# ─────────────────────────────────────────────────────────────

# ── Панель Remnawave ─────────────────────────────────────────
# Адрес API панели. По умолчанию — бэкенд на этом же сервере.
RW_API_URL=http://127.0.0.1:3000
# API-токен (Панель → Настройки → API-токены). Нужны права только на чтение:
# nodes, users, subscriptions (raw, connection-keys), geocheck, geocheck-result.
RW_API_TOKEN=
# Доп. заголовки к API через «;», если панель закрыта защитой, например:
# RW_API_HEADERS=Cookie: abcdef=123456
RW_API_HEADERS=

# Метрики панели (секция PROMETHEUS в /opt/remnawave/.env)
RW_METRICS_PORT=3001
RW_METRICS_USER=admin
RW_METRICS_PASS=

# Название панели в заголовке ежедневной сводки (необязательно)
PANEL_NAME=

# ── Telegram ─────────────────────────────────────────────────
TG_BOT_TOKEN=
TG_CHAT_ID=
# ID топика в группе с темами. Пусто — писать в общий чат.
TG_TOPIC_ID=

# ── Grafana ──────────────────────────────────────────────────
# Grafana слушает только 127.0.0.1, наружу её отдаёт nginx.
GRAFANA_PORT=3300
GRAFANA_DOMAIN=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ── Prometheus ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=90d

# ── Проверка хостов (xray-checker) ──────────────────────────
# Служебный пользователь панели: его подписка используется для проверок.
MONITOR_USERNAME=monitoring
# Хосты с этим тегом проходят все три проверки: Xray, WARP, Psiphon.
MONITOR_HOST_TAG=MONITORING
# Хосты с этим тегом — только «Xray жив» (одна лёгкая проверка).
# Для хостов с лимитом трафика: LTE, цепочки через CDN и т.п.
MONITOR_HOST_TAG_LITE=MONITORING_LITE
# Как часто проверять, секунд.
CHECK_INTERVAL=300
# Что открываем через ноду:
#  «Xray жив»  — идёт напрямую (DIRECT)
CHECK_URL_XRAY=https://www.google.com/generate_204
#  «WARP жив»  — домен из geosite:category-ip-geo-detect, нода отправит его в WARP
CHECK_URL_WARP=https://icanhazip.com
#  «Psiphon жив» — домен, который правилом ноды отправлен в Psiphon
CHECK_URL_PSIPHON=http://ip-api.com/line/?fields=query

# ── Алерты ───────────────────────────────────────────────────
# «Клиенты пропали»: за прошлый час в среднем было не меньше N человек,
# а последние 5 минут на ноде не больше M.
CLIENTS_DROP_MIN_AVG=3
CLIENTS_DROP_MAX_NOW=1
# Теги аутбаундов для пассивной проверки (регулярное выражение)
OUTBOUND_TAGS=psiphon-out|WARP

# ── Ежедневная сводка и GeoCheck ────────────────────────────
REPORT_TIME=15:00
GEOCHECK_TIME=14:30
# Не прогонять GeoCheck на этих нодах (имена или теги нод через запятую)
GEOCHECK_EXCLUDE=
# Страны, которые подсвечиваем как плохие, если сервис видит ноду в них
GEOCHECK_BAD_COUNTRIES=RU,BY
# Прикладывать к отчёту картинки GeoCheck (увеличивает размер файла)
GEOCHECK_ATTACH_IMAGES=true
