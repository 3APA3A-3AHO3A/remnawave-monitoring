# ─────────────────────────────────────────────────────────────
#  remnawave-monitoring — настройки Docker (порты, Grafana).
#  Всё про панели, Telegram и проверки — в config.toml.
#  cp .env.example .env && chmod 600 .env
# ─────────────────────────────────────────────────────────────

# Grafana слушает только 127.0.0.1, наружу её отдаёт nginx.
GRAFANA_PORT=3300
GRAFANA_DOMAIN=
# Применяются только при первом запуске Grafana
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=90d

# Порт, на котором reporter отдаёт метрики панелей (только 127.0.0.1)
REPORTER_PORT=9105
