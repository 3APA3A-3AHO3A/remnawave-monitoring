          "type": "prometheus",
          "uid": "rwmon-prometheus"
        },
        "query": {
          "query": "label_values(remnawave_node_outbound_upload_bytes, tag)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(remnawave_node_outbound_upload_bytes, tag)",
        "regex": "/^(?!BLOCK$|RW_TB_OUTBOUND_BLOCK$|DIRECT$).*/",
        "multi": true,
        "includeAll": false,
        "refresh": 2,
        "current": {
          "selected": true,
          "text": [
            "psiphon-out",
            "WARP"
