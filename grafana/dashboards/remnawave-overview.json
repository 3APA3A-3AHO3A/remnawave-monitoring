    {
      "id": 7,
      "type": "timeseries",
      "title": "Клиенты по нодам",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "rwmon-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rwmon-prometheus"
          },
          "expr": "sum by (node_name) (remnawave_node_online_users * on (node_uuid) group_left (node_name) topk by (node_uuid) (1, remnawave_node_basic_info))",
          "legendFormat": "{{node_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Трафик клиентов по нодам",
      "description": "Скорость трафика пользователей через ноду (вход + выход)",
      "datasource": {
        "type": "prometheus",
        "uid": "rwmon-prometheus"
