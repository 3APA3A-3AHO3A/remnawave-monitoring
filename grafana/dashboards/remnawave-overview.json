      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rwmon-prometheus"
          },
          "expr": "sum by (node_name) ((sum by (node_uuid) (rate(remnawave_node_inbound_upload_bytes[5m]) + rate(remnawave_node_inbound_download_bytes[5m]))) * on (node_uuid) group_left (node_name) topk by (node_uuid) (1, remnawave_node_basic_info))",
          "legendFormat": "{{node_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
