    {
      "id": 5,
      "type": "table",
      "title": "Ноды: сколько людей и трафика",
      "datasource": {
        "type": "prometheus",
        "uid": "rwmon-prometheus"
      },
      "gridPos": {
        "h": 14,
        "w": 11,
        "x": 0,
        "y": 5
      },
      "description": "Трафик — сколько прошло через ноду за последние 24 часа",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rwmon-prometheus"
          },
          "expr": "sum by (node_name) (remnawave_node_online_users * on (node_uuid) group_left (node_name) topk by (node_uuid) (1, remnawave_node_basic_info))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "rwmon-prometheus"
          },
          "expr": "sum by (node_name) ((sum by (node_uuid) (increase(remnawave_node_inbound_upload_bytes[24h]) + increase(remnawave_node_inbound_download_bytes[24h]))) * on (node_uuid) group_left (node_name) topk by (node_uuid) (1, remnawave_node_basic_info))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node_name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "node_name": "Нода",
              "Value #A": "Клиентов сейчас",
              "Value #B": "Трафик за сутки"
            },
            "indexByName": {
              "node_name": 0,
              "Value #A": 1,
              "Value #B": 2
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Клиентов сейчас",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Клиентов сейчас"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Трафик за сутки"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Нода"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Хосты: работает ли у клиента",
      "datasource": {
        "type": "prometheus",
        "uid": "rwmon-prometheus"
      },
      "gridPos": {
        "h": 14,
        "w": 13,
        "x": 11,
        "y": 5
      },
      "description": "Проверка подключается к хосту как клиент. Подключение — нода принимает клиентов; WARP и Psiphon — через ноду открываются адреса, которые идут в эти аутбаунды.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rwmon-prometheus"
          },
          "expr": "max by (name) (xray_proxy_status{check=\"xray\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "rwmon-prometheus"
          },
          "expr": "max by (name) (xray_proxy_status{check=\"warp\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "rwmon-prometheus"
          },
          "expr": "max by (name) (xray_proxy_status{check=\"psiphon\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "renameByName": {
              "name": "Хост",
              "Value #A": "Подключение",
              "Value #B": "WARP",
              "Value #C": "Psiphon"
            },
            "indexByName": {
              "name": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Подключение",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "СБОЙ",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "—",
                  "color": "transparent",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Подключение|WARP|Psiphon"
            },
            "properties": [
