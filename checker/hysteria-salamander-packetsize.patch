+
+// rangeString turns a JSON range value ("900-1400" or 1200) into a string.
+func rangeString(raw json.RawMessage) string {
+	if len(raw) == 0 || string(raw) == "null" {
+		return ""
+	}
+	var s string
+	if err := json.Unmarshal(raw, &s); err == nil {
+		return strings.TrimSpace(s)
+	}
+	return strings.TrimSpace(string(raw))
+}
+
+// applyHysteriaFinalMask reads Salamander settings from the "fm" link query.
+func applyHysteriaFinalMask(pc *models.ProxyConfig, fm string) {
+	var mask struct {
+		Udp []struct {
+			Type     string          `json:"type"`
+			Settings json.RawMessage `json:"settings"`
+		} `json:"udp"`
+	}
+	if err := json.Unmarshal([]byte(fm), &mask); err != nil {
+		logger.Debug("Failed to parse hysteria finalmask: %v", err)
+		return
+	}
+	for _, m := range mask.Udp {
+		if m.Type != "salamander" || len(m.Settings) == 0 {
+			continue
+		}
+		var sal libXraySalamander
+		if err := json.Unmarshal(m.Settings, &sal); err != nil {
+			continue
+		}
+		if pc.HysteriaObfsPassword == "" && sal.Password != "" {
+			pc.HysteriaObfs = "salamander"
+			pc.HysteriaObfsPassword = sal.Password
+		}
+		if ps := rangeString(sal.PacketSize); ps != "" {
+			pc.HysteriaObfsPacketSize = ps
+		}
+	}
+}
