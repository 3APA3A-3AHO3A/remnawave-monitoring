@@ -147,3 +147,16 @@ func TestSanitizeLabelName(t *testing.T) {
 		}
 	}
 }
+
+// rwmon: IP выхода — отдельная серия с меткой ip, только у успешной проверки
+func TestCollectorExitIP(t *testing.T) {
+	src := fakeSource{[]ProxyMetric{
+		{Protocol: "vless", Address: "1.1.1.1:443", Name: "A", StableID: "id1", Online: true, ExitIP: "104.28.1.2"},
+		{Protocol: "vless", Address: "2.2.2.2:443", Name: "B", StableID: "id2", Online: false, ExitIP: "5.6.7.8"},
+		{Protocol: "vless", Address: "3.3.3.3:443", Name: "C", StableID: "id3", Online: true},
+	}}
+	got := gatherSeries(t, NewCollector("", src))["xray_proxy_exit_ip"]
+	if len(got) != 1 || !strings.Contains(got[0], "ip=104.28.1.2") || !strings.Contains(got[0], "name=A") {
+		t.Errorf("want one exit ip series for A, got %v", got)
+	}
+}
