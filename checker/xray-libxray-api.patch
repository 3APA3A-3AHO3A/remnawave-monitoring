+// convertShareLinks — прежний вызов libXray.ConvertShareLinksToXrayJson (base64 на входе и на
+// выходе, ответ {success, data}) поверх нового API libxray (share.ConvertShareLinksToXrayJson
+// с обычным текстом): libxray под xray-core v26.11 убрал старую обёртку (rwmon).
+func convertShareLinks(linksBase64 string) string {
+	resp := libXrayResponse{}
+	if links, err := base64.StdEncoding.DecodeString(linksBase64); err == nil {
+		if data, err := share.ConvertShareLinksToXrayJson(string(links), ""); err == nil {
+			resp.Success, resp.Data = true, data
+		}
+	}
+	out, _ := json.Marshal(resp)
+	return base64.StdEncoding.EncodeToString(out)
+}
+
