diff --git a/checker/errcode.go b/checker/errcode.go
new file mode 100644
index 0000000..75aab2d
--- /dev/null
+++ b/checker/errcode.go
@@ -0,0 +1,50 @@
+package checker
+
+import (
+	"errors"
+	"net"
+	"strings"
+)
+
+// rwmon: причина сбоя проверки числом — по нему алерт пишет, с чем столкнулись.
+// Числа неизменны: их расшифровывает мониторинг (reporter/rwmon/render.py).
+const (
+	ErrOther      = 1 // другое
+	ErrTimeout    = 2 // хост не ответил вовремя
+	ErrClosed     = 3 // соединение закрыто без ответа (EOF)
+	ErrReset      = 4 // соединение сброшено
+	ErrRefused    = 5 // в соединении отказано
+	ErrTLS        = 6 // ошибка TLS
+	ErrDNS        = 7 // имя не разрешилось
+	ErrBadAnswer  = 8 // ответ пришёл, но не тот (код HTTP, IP не сменился, мало данных)
+	ErrSocksProxy = 9 // Xray проверки не смог подключиться к хосту (отказ SOCKS)
+)
+
+// ErrorCode сводит ошибку запроса через прокси к одной из причин выше.
+func ErrorCode(err error) int {
+	if err == nil {
+		return 0
+	}
+	var ne net.Error
+	if errors.As(err, &ne) && ne.Timeout() {
+		return ErrTimeout
+	}
+	m := strings.ToLower(err.Error())
+	switch {
+	case strings.Contains(m, "timeout") || strings.Contains(m, "deadline exceeded"):
+		return ErrTimeout
+	case strings.Contains(m, "socks") || strings.Contains(m, "proxyconnect"):
+		return ErrSocksProxy
+	case strings.Contains(m, "no such host") || strings.Contains(m, "server misbehaving"):
+		return ErrDNS
+	case strings.Contains(m, "tls") || strings.Contains(m, "x509") || strings.Contains(m, "certificate"):
+		return ErrTLS
+	case strings.Contains(m, "connection refused"):
+		return ErrRefused
+	case strings.Contains(m, "connection reset") || strings.Contains(m, "broken pipe"):
+		return ErrReset
+	case strings.Contains(m, "eof"):
+		return ErrClosed
+	}
+	return ErrOther
+}
diff --git a/checker/errcode_test.go b/checker/errcode_test.go
new file mode 100644
index 0000000..afcbc44
--- /dev/null
+++ b/checker/errcode_test.go
@@ -0,0 +1,30 @@
+package checker
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"testing"
+)
+
+// rwmon: ошибки запроса через прокси сводятся к причинам
+func TestErrorCode(t *testing.T) {
+	cases := map[error]int{
+		nil: 0,
+		fmt.Errorf("Get \"https://www.google.com/generate_204\": %w", io.EOF):                                         ErrClosed,
+		fmt.Errorf("Get \"x\": %w", context.DeadlineExceeded):                                                         ErrTimeout,
+		errors.New("Get \"x\": context deadline exceeded (Client.Timeout exceeded while awaiting headers)"):           ErrTimeout,
+		errors.New("Get \"x\": socks connect tcp 127.0.0.1:21000->x:443: unknown error general SOCKS server failure"): ErrSocksProxy,
+		errors.New("Get \"x\": dial tcp: lookup x: no such host"):                                                     ErrDNS,
+		errors.New("Get \"x\": tls: handshake failure"):                                                               ErrTLS,
+		errors.New("Get \"x\": read tcp 1.2.3.4:5->6.7.8.9:443: read: connection reset by peer"):                      ErrReset,
+		errors.New("Get \"x\": dial tcp 127.0.0.1:21000: connect: connection refused"):                                ErrRefused,
+		errors.New("что-то другое"):                                                                                   ErrOther,
+	}
+	for err, want := range cases {
+		if got := ErrorCode(err); got != want {
+			t.Errorf("%v: got %d, want %d", err, got, want)
+		}
+	}
+}
diff --git a/checker/exit_ip_test.go b/checker/exit_ip_test.go
new file mode 100644
index 0000000..ee6c64b
--- /dev/null
+++ b/checker/exit_ip_test.go
@@ -0,0 +1,28 @@
+package checker
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+// rwmon: IP выхода разбирается из ответа сервиса проверки; мусор — пустая строка
+func TestCheckByIPExit(t *testing.T) {
+	for body, want := range map[string]string{
+		"104.28.1.2\n":   "104.28.1.2",
+		" 2606:4700::1 ": "2606:4700::1",
+		"<html>":         "",
+	} {
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			fmt.Fprint(w, body)
+		}))
+		pc := &ProxyChecker{ipCheck: srv.URL, currentIP: "9.9.9.9\n"}
+		exit := "stale"
+		ok, _, _, err := pc.checkByIP(srv.Client(), &exit)
+		srv.Close()
+		if err != nil || !ok || exit != want {
+			t.Errorf("body %q: ok=%v err=%v exit=%q, want %q", body, ok, err, exit, want)
+		}
+	}
+}
