diff --git a/subscription/via_test.go b/subscription/via_test.go
new file mode 100644
index 0000000..a4fcc20
--- /dev/null
+++ b/subscription/via_test.go
@@ -0,0 +1,30 @@
+package subscription
+
+import "testing"
+
+// Аутбаунд с тегом rwmon-via — посредник для остальных аутбаундов конфига,
+// сам он в список проверок не попадает (rwmon-via.patch).
+func TestParseJSONConfigsVia(t *testing.T) {
+	data := []byte(`[{"remarks": "LTE 3", "outbounds": [
+	  {"tag": "proxy", "protocol": "vless", "settings": {"vnext": [{"address": "1.1.1.1", "port": 443,
+	    "users": [{"id": "b831381d-6324-4d53-ad4f-8cda48b30811", "encryption": "none"}]}]}},
+	  {"tag": "rwmon-via", "protocol": "vless", "settings": {"vnext": [{"address": "2.2.2.2", "port": 443,
+	    "users": [{"id": "b831381d-6324-4d53-ad4f-8cda48b30812", "encryption": "none"}]}]}}
+	]}, {"remarks": "Plain", "outbounds": [
+	  {"tag": "proxy", "protocol": "vless", "settings": {"vnext": [{"address": "3.3.3.3", "port": 443,
+	    "users": [{"id": "b831381d-6324-4d53-ad4f-8cda48b30813", "encryption": "none"}]}]}}
+	]}]`)
+	got, err := NewParser().parseJSONConfigs(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 {
+		t.Fatalf("ожидалось 2 проверки (посредник не проверяется), получено %d", len(got))
+	}
+	if got[0].Name != "LTE 3" || got[0].Via == nil || got[0].Via.Server != "2.2.2.2" {
+		t.Errorf("LTE 3 должен идти через 2.2.2.2: name=%q via=%+v", got[0].Name, got[0].Via)
+	}
+	if got[1].Via != nil {
+		t.Errorf("Plain не должен получать посредника")
+	}
+}
diff --git a/xray/config.go b/xray/config.go
index 182d440..2992adf 100644
--- a/xray/config.go
+++ b/xray/config.go
@@ -164,6 +164,26 @@ func (g *ConfigGenerator) generateOutbounds(proxies []*models.ProxyConfig) []map
 
 	for _, proxy := range proxies {
 		outbound := g.generateProxyOutbound(proxy)
+		if proxy.Via != nil {
+			// Подключение через посредника (rwmon): у каждого хоста свой экземпляр
+			// аутбаунда-посредника с уникальным тегом
+			via := g.generateProxyOutbound(proxy.Via)
+			viaTag := outboundTag(proxy) + "_via"
+			via["tag"] = viaTag
+			ss, _ := outbound["streamSettings"].(map[string]interface{})
+			if ss == nil {
+				ss = map[string]interface{}{}
+				outbound["streamSettings"] = ss
+			}
+			sockopt, _ := ss["sockopt"].(map[string]interface{})
+			if sockopt == nil {
+				sockopt = map[string]interface{}{}
+				ss["sockopt"] = sockopt
+			}
+			sockopt["dialerProxy"] = viaTag
+			outbounds = append(outbounds, outbound, via)
+			continue
+		}
 		outbounds = append(outbounds, outbound)
 	}
 
diff --git a/xray/via_test.go b/xray/via_test.go
new file mode 100644
index 0000000..1d731b3
--- /dev/null
+++ b/xray/via_test.go
@@ -0,0 +1,48 @@
+package xray
+
+import (
+	"encoding/json"
+	"testing"
+
+	"xray-checker/models"
+)
+
+// Подключение через посредника (rwmon-via.patch): у хоста свой аутбаунд-посредник,
+// а сам хост подключается через него (sockopt.dialerProxy). Конфиг собирается ядром.
+func TestGenerateConfigWithVia(t *testing.T) {
+	via := &models.ProxyConfig{Protocol: "vless", Name: "msk", Server: "10.0.0.1", Port: 443,
+		UUID: "b831381d-6324-4d53-ad4f-8cda48b30811", Index: 1}
+	proxy := &models.ProxyConfig{
+		Protocol: "hysteria", Name: "lte", Server: "example.com", Port: 20009, Index: 0,
+		SNI: "example.com", Security: "tls", HysteriaAuth: "secret-auth",
+		HysteriaObfs: "salamander", HysteriaObfsPassword: "obfs-pass", Via: via,
+	}
+	plain := &models.ProxyConfig{Protocol: "vless", Name: "plain", Server: "10.0.0.2", Port: 443,
+		UUID: "b831381d-6324-4d53-ad4f-8cda48b30812", Index: 2}
+
+	configBytes := buildsWithXrayCore(t, []*models.ProxyConfig{proxy, plain})
+	var parsed struct {
+		Outbounds []struct {
+			Tag            string `json:"tag"`
+			StreamSettings struct {
+				Sockopt map[string]interface{} `json:"sockopt"`
+			} `json:"streamSettings"`
+		} `json:"outbounds"`
+	}
+	if err := json.Unmarshal(configBytes, &parsed); err != nil {
+		t.Fatal(err)
+	}
+	tags := map[string]map[string]interface{}{}
+	for _, o := range parsed.Outbounds {
+		tags[o.Tag] = o.StreamSettings.Sockopt
+	}
+	if _, ok := tags["lte_0_via"]; !ok {
+		t.Fatalf("нет аутбаунда-посредника lte_0_via: %v", tags)
+	}
+	if got := tags["lte_0"]["dialerProxy"]; got != "lte_0_via" {
+		t.Errorf("lte_0 должен подключаться через lte_0_via, dialerProxy=%v", got)
+	}
+	if _, ok := tags["plain_2"]["dialerProxy"]; ok {
+		t.Errorf("хост без посредника не должен получать dialerProxy")
+	}
+}
