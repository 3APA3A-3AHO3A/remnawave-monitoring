+			if attempt > 1 {
+				logger.Warn("%s | Success on attempt %d/%d", proxy.Name, attempt, attempts)
+			}
+			break
+		}
+		if attempt < attempts {
+			time.Sleep(retryDelay)
+		}
 	}
 
 	if checkErr != nil {
@@ -468,3 +484,16 @@ func (pc *ProxyChecker) GetProxies() []*models.ProxyConfig {
