 	return result
 }
+
+// checkAttempts reads PROXY_CHECK_ATTEMPTS (default 1) and PROXY_CHECK_RETRY_DELAY
+// in seconds (default 5). Added by rwmon.
+func checkAttempts() (int, time.Duration) {
+	attempts, delay := 1, 5
+	if v, err := strconv.Atoi(os.Getenv("PROXY_CHECK_ATTEMPTS")); err == nil && v > 0 {
+		attempts = v
+	}
+	if v, err := strconv.Atoi(os.Getenv("PROXY_CHECK_RETRY_DELAY")); err == nil && v >= 0 {
+		delay = v
+	}
+	return attempts, time.Duration(delay) * time.Second
+}
