# Шаблон. Значения __RW_METRICS_PORT__ и __RW_METRICS_USER__ подставляются
# при старте контейнера из .env (см. docker-compose.yml), пароль кладётся
# в отдельный файл и в конфиг не попадает.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  # Метрики самой панели: ноды, пользователи, трафик по аутбаундам
  - job_name: remnawave
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:__RW_METRICS_PORT__"]
    basic_auth:
      username: "__RW_METRICS_USER__"
      password_file: /prometheus/.rw_metrics_pass

  # Три копии xray-checker: у каждой своя проверка
  - job_name: xray-checker
    scrape_interval: 60s
    static_configs:
      - targets: ["127.0.0.1:2112"]
        labels: { check: xray }
      - targets: ["127.0.0.1:2113"]
        labels: { check: warp }
      - targets: ["127.0.0.1:2114"]
        labels: { check: psiphon }
